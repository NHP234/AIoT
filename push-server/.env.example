FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# Option A: path to a Firebase service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B: paste the full service account JSON into one env var instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

PORT=3001
